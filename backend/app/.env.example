# Copy this file to backend/.env and fill in your values.

# One OpenAI-compatible endpoint that serves all three council models.
# The thesis runs used a gateway exposing them as gemini-2.0-flash, deepseek-chat and qwen3-235b-a22b.
# With another provider, change each model's "api_name" in app/config.py to that provider's id.
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1

# Server
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Limits
MAX_CONCURRENT_LLMS=7
REQUEST_TIMEOUT=300
