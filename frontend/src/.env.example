# Backend API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_API_PREFIX=/api

# SSE Configuration
VITE_SSE_RETRY_INTERVAL=3000
VITE_SSE_MAX_RETRIES=5

# Application Settings
VITE_APP_NAME=Intelligent Test Council
VITE_APP_VERSION=1.0.0

# Development Settings
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info

# Feature Flags
VITE_ENABLE_ANIMATIONS=true
VITE_ENABLE_SOUND_EFFECTS=false
VITE_ENABLE_DARK_MODE=true

# Code Editor Settings
VITE_EDITOR_THEME=vs-dark
VITE_EDITOR_FONT_SIZE=14
VITE_EDITOR_TAB_SIZE=4

# Timeouts (milliseconds)
VITE_REQUEST_TIMEOUT=300000
VITE_SSE_TIMEOUT=300000

# Example Code Samples
VITE_LOAD_DEFAULT_EXAMPLES=true
